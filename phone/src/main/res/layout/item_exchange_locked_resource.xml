<?xml version="1.0" encoding="utf-8"?>
<!-- S0028: a resource behind a PIN, listed locked and never opened (DEVICE-EXCHANGE item AJ) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvLockedName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        tools:text="Holiday photos" />

    <TextView
        android:id="@+id/tvLockedDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        tools:text="Pixel 9 Pro" />

    <TextView
        android:id="@+id/tvLockedNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exchange_failure_protection_unsupported"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

</LinearLayout>
