<?xml version="1.0" encoding="utf-8"?>
<!-- S0049: the Broadcast page of the settings screen, one editor of the broadcast settings with two entry points
     (SETTINGS-NAVIGATION 2.0 section 3.2). While broadcasting is off the rows stay hidden and one line says where the
     switch is. One coherent set, so no group wrapper (COLLAPSIBLE-GROUP 1.1 section 2.2). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsBroadcastScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/settings_page_inset"
        android:paddingVertical="@dimen/margin_normal">

        <TextView
            android:id="@+id/broadcastOffNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_normal"
            android:text="@string/settings_broadcast_off_notice"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <!-- Child navigation inside the same window: the trailing chevron of BUTTONS 2.0 section 2.3. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenGeneral"
            style="@style/Widget.StreamsPlayer.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_open_general"
            android:visibility="gone"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd" />

        <include
            android:id="@+id/broadcastPanel"
            layout="@layout/fragment_settings_broadcast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
