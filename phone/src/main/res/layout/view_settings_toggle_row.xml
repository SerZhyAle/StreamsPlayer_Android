<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout for SettingsToggleRow compound view (BOOLEAN-OPTION 2.0).
  Canonical pattern: checkbox (leftmost) + text group (title + helper inline, subtitle below) + optional trailing slot.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- BOOLEAN-OPTION 2.0: leading visible checkbox (S0036).
         Aligned with the first heading line, not the vertical center of a long explanation (section 2 rule 1). -->
    <com.sza.streamsplayer.ui.common.widget.SettingsCheckBox
        android:id="@+id/str_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginEnd="@dimen/ui_option_checkbox_gap"
        android:minWidth="@dimen/ui_touch_target"
        android:minHeight="@dimen/ui_touch_target"
        android:clickable="true"
        android:focusable="true" />

    <!-- Optional leading feature icon. Decorative; sits next to the label, hidden when unset. -->
    <ImageView
        android:id="@+id/str_icon"
        android:layout_width="@dimen/ui_option_glyph"
        android:layout_height="@dimen/ui_option_glyph"
        android:layout_gravity="top"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/ui_option_inline_gap"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:tint="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/str_textGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title line: title + helper inline (helper sits next to the title, NOT at the right edge of the row). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/str_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/ui_option_caption_text" />

            <ImageButton
                android:id="@+id/str_iconHelp"
                android:layout_width="@dimen/ui_touch_target"
                android:layout_height="@dimen/ui_touch_target"
                android:layout_marginStart="@dimen/ui_option_inline_gap"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription=""
                android:focusable="true"
                android:src="@drawable/ic_help_outline"
                app:tint="@color/text_color_secondary"
                android:visibility="gone" />

            <!-- Spacer fills remaining width so the helper sits next to the title, not pushed right.
                 Identified so setHugsTextContent() can collapse it when the row must wrap its label. -->
            <View
                android:id="@+id/str_titleLineSpacer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        </LinearLayout>

        <TextView
            android:id="@+id/str_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_option_heading_gap"
            android:textColor="@color/text_color_secondary"
            android:textSize="@dimen/ui_option_explanation_text"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Optional trailing action slot for the rare row that needs a secondary action. Hidden by default. -->
    <FrameLayout
        android:id="@+id/str_trailingSlot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:visibility="gone" />

</merge>
