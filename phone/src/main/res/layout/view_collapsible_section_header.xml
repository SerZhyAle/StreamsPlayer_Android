<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout for CollapsibleSectionHeader compound view (COLLAPSIBLE-GROUP 1.1).
  Canonical pattern: state triangle (leftmost) + optional category icon + text group (title + summary below) + optional trailing slot.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/csh_headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ui_touch_target"
        android:background="?attr/colorSurfaceVariant"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/focus_button_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_group_marker_gap"
        android:paddingEnd="@dimen/ui_group_marker_gap"
        android:paddingTop="@dimen/settings_padding_vertical"
        android:paddingBottom="@dimen/settings_padding_vertical">

        <!-- COLLAPSIBLE-GROUP 1.1: State triangle marker.
             Base orientation points down (expanded); rotated to point reading-end (right in LTR, left in RTL) when collapsed. -->
        <ImageView
            android:id="@+id/csh_chevron"
            android:layout_width="@dimen/ui_group_marker"
            android:layout_height="@dimen/ui_group_marker"
            android:layout_marginEnd="@dimen/ui_group_marker_gap"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_arrow_drop_down"
            app:tint="?attr/colorOnSurfaceVariant" />

        <!-- Optional leading category icon. Decorative; hidden when unset. -->
        <ImageView
            android:id="@+id/csh_icon"
            android:layout_width="@dimen/icon_tier_20"
            android:layout_height="@dimen/icon_tier_20"
            android:layout_marginEnd="@dimen/ui_group_marker_gap"
            android:importantForAccessibility="no"
            app:tint="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/csh_prefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/csh_iconHelp"
            android:layout_width="@dimen/ui_touch_target"
            android:layout_height="@dimen/ui_touch_target"
            android:layout_marginEnd="@dimen/ui_group_marker_gap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription=""
            android:focusable="true"
            android:src="@drawable/ic_help_outline"
            app:tint="@color/text_color_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/csh_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:textSize="@dimen/collapsible_section_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/csh_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/toggler_desc_text_size"
                android:visibility="gone" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/csh_trailingSlot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

</merge>
