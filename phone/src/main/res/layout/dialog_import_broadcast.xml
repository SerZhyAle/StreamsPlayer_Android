<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_medium"
    android:paddingTop="@dimen/margin_normal"
    android:paddingEnd="@dimen/margin_medium"
    android:paddingBottom="@dimen/margin_normal">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/broadcastInputLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/import_broadcast_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBroadcastPayload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri|textMultiLine"
            android:maxLines="4" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- S0049: content-width commands that wrap whole (BUTTONS 2.0 section 4.2). -->
    <com.sza.streamsplayer.ui.common.widget.CommandFlowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_normal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChooseBroadcastFile"
            style="@style/Widget.StreamsPlayer.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/import_broadcast_choose_file"
            app:icon="@drawable/ic_stream" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanBroadcastQr"
            style="@style/Widget.StreamsPlayer.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_scanner_title"
            app:icon="@drawable/ic_camera_capture" />
    </com.sza.streamsplayer.ui.common.widget.CommandFlowLayout>

</LinearLayout>
