<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margin_medium"
    android:paddingTop="@dimen/margin_normal"
    android:paddingEnd="@dimen/margin_medium"
    android:paddingBottom="@dimen/margin_normal">

    <ImageView
        android:id="@+id/ivChannelIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="@dimen/margin_normal"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/ic_stream" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChannelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Radio Paradise" />

        <TextView
            android:id="@+id/tvChannelSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="Audio • Music" />
    </LinearLayout>

</LinearLayout>
