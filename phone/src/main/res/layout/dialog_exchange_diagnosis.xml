<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- S0035: the title row; the help action stands in its end corner (CONTEXT-HELP rule 2). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exchange_failure_dialog_title"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDiagnosisHelp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/help"
                android:src="@drawable/ic_help_outline" />
        </LinearLayout>

        <TextView
            android:id="@+id/textHappenedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exchange_failure_happened"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold"
            android:alpha="0.8" />

        <TextView
            android:id="@+id/textHappened"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Cannot reach the server." />

        <LinearLayout
            android:id="@+id/layoutTry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/textTryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exchange_failure_try"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textStyle="bold"
                android:alpha="0.8" />

            <TextView
                android:id="@+id/textTry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="Check the address, and make sure both devices are on the same Wi-Fi or home network." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRunning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressRunning"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminate="true"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/textRunning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exchange_failure_running"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:alpha="0.8" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleDetails"
            style="@style/Widget.StreamsPlayer.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exchange_failure_details"
            app:icon="@drawable/ic_arrow_drop_down"
            app:iconGravity="textEnd"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:id="@+id/layoutDetailsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textServerLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="Server: 192.168.1.10:443" />

            <TextView
                android:id="@+id/textCodeLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="Code: unreachable" />

            <TextView
                android:id="@+id/textStepsHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exchange_failure_steps_heading"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textStyle="bold"
                android:alpha="0.8"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/layoutStepsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <com.sza.streamsplayer.ui.common.widget.CommandFlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHelp"
                style="@style/Widget.StreamsPlayer.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exchange_failure_open_help" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopy"
                style="@style/Widget.StreamsPlayer.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exchange_failure_copy_report"
                app:icon="@drawable/ic_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/Widget.StreamsPlayer.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exchange_failure_next_step"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgain"
                style="@style/Widget.StreamsPlayer.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exchange_failure_again" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                style="@style/Widget.StreamsPlayer.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exchange_failure_close" />
        </com.sza.streamsplayer.ui.common.widget.CommandFlowLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
