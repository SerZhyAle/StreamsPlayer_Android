    <!-- S0031: connection diagnosis - check ladder steps (DEVICE-EXCHANGE 25 item CY) -->
    <string name="exchange_step_pc_asleep">Switch on and wake the device that runs the server or the sharing service, and keep it from going to sleep.</string>
    <string name="exchange_step_address_lan">Check the address, and make sure both devices are on the same Wi-Fi or home network.</string>
    <string name="exchange_step_guest_network">Join the main Wi-Fi network, not the router\'s guest network: in a guest network devices often cannot see each other.</string>
    <string name="exchange_step_vpn">Turn the VPN off on this device for a moment and try again.</string>
    <string name="exchange_step_windows_public_network">On the Windows computer, set this network to private: Windows keeps other devices out of a public network.</string>
    <string name="exchange_step_ip_family">Try another network, for example mobile data: the server may be reachable only by a kind of address (IPv4 or IPv6) that this network does not give you.</string>
    <string name="exchange_step_server_internet">From another network, for example mobile data, check that the server answers from the internet.</string>
    <string name="exchange_step_port_forward">In the router\'s settings, forward the server\'s port to the computer that runs it.</string>
    <string name="exchange_step_device_clock">Set the right date and time on this device, or turn on automatic time, and try again.</string>
    <string name="exchange_step_certificate">If you did not expect this, do not go on: ask whoever runs the server. If the server was reinstalled, confirm its new fingerprint.</string>
    <string name="exchange_step_credentials">Check the login and type the password again. If you used a one-time code, ask for a new one.</string>
    <string name="exchange_step_sign_in_rate">Wait a few seconds and try again: the server takes about one attempt per second.</string>
    <string name="exchange_step_invitation">Check the invitation or ask for a new one: each works once, and this one may be wrong, used or withdrawn.</string>
    <string name="exchange_step_device_removed">Sign in to the account again to add this device back.</string>
    <string name="exchange_step_operator">Ask whoever runs the server: this can be fixed only on the server\'s side.</string>

