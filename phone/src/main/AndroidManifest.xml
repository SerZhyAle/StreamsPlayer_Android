<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- work-runtime asks for this to reschedule after a reboot. A pending artwork download simply resumes at the next launch. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".StreamsPlayerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.StreamsPlayer">

        <!-- S0050: WorkManager is initialized from StreamsPlayerApplication so its workers get Hilt. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- S0020: Broadcast link hand-off -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fmsbcast" android:host="import" />
            </intent-filter>
            <!-- S0020: Broadcast file hand-off -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.fms.bcast+json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.fmsbcast" />
            </intent-filter>
        </activity>

        <!-- S0019: Exchange import thin activity for .fmsexch and text/plain -->
        <activity
            android:name=".ui.exchange.ExchangeImportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-fmsexch" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.fmsexch" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- S0019: Exchange server join, directory, and account activity -->
        <activity
            android:name=".ui.exchange.ExchangeActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- S0049: lets a profiler connected over adb read the page-switch trace sections of a release build, which
             SETTINGS-NAVIGATION 2.0 section 5.4 requires its timings to come from. No permission, no user effect. -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <!-- S0049: the settings screen (SETTINGS-NAVIGATION 2.0) -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.player.FullscreenPlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.broadcast.BroadcastControlActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.broadcast.BroadcastEntryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.broadcast.BroadcastShareActivity"
            android:exported="false" />

        <activity
            android:name=".ui.scanner.QrScannerActivity"
            android:exported="false" />

        <service
            android:name=".service.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/streamsplayer/" />
            </intent-filter>
        </service>

        <service
            android:name=".ui.player.AudioPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <service
            android:name=".broadcast.BroadcastCaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".broadcast.BroadcastTileService"
            android:exported="true"
            android:icon="@drawable/ic_live_broadcast"
            android:label="@string/tile_broadcast_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".widget.StreamPlayLaunchActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.sza.streamsplayer.action.PLAY_STREAM_HEADLESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- S0035: offline help viewer; reached only from the app's own help actions. -->
        <activity
            android:name=".ui.common.help.HelpPageActivity"
            android:exported="false" />

        <activity
            android:name=".widget.StreamLaunchWidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.BroadcastEntryWidgetProvider"
            android:exported="true"
            android:icon="@drawable/ic_live_broadcast"
            android:label="@string/widget_broadcast_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_broadcast_entry_info" />
        </receiver>

        <receiver
            android:name=".widget.StreamLaunchWidgetProvider"
            android:exported="true"
            android:icon="@drawable/ic_stream"
            android:label="@string/widget_stream_launch_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stream_launch_info" />
        </receiver>

        <service
            android:name=".ui.player.AudioToggleTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_play"
            android:label="@string/tile_radio_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
