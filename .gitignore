# The globs above are for secrets files; they must not hide product source (RoomSecretStore.kt, UiSizeTokens.kt) or the
# self-signed test identity of BroadcastTunnelTlsTest (password "changeit", PROVENANCE.txt beside it), which a fresh
# clone needs to compile and test (S0046 A7).
!**/src/**/*.kt
!exchange-core/src/test/resources/device-exchange/tunnel-test.p12

